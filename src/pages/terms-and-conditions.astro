---
import Base from "../layouts/Base.astro";
import body from "../content/terms-and-conditions.html?raw";
import pages from "../pages.json";
const m = pages["terms-and-conditions"];
---
<Base title={m.title} desc={m.desc} canon={m.canon} active={m.active} sub={m.sub} withSchema={false}>
  <Fragment set:html={body} />
</Base>
